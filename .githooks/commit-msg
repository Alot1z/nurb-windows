#!/bin/bash
# Prevent "Generated with Codebuff" and "Co-Authored-By: Codebuff" in commit messages
if grep -q "Generated with Codebuff\|Co-Authored-By: Codebuff" "$1"; then
    echo "ERROR: Commit message contains Generated/Co-Authored lines."
    echo "These are not allowed. Please remove them and try again."
    exit 1
fi
